{
  "name": "midea-jre-uniland-energy-report",
  "version": "0.3.1-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --built",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run format:check && npm test && npm run build",
    "db:check": "node scripts/database.mjs check",
    "db:migrate": "node scripts/database.mjs migrate",
    "admin:create": "node scripts/database.mjs bootstrap",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.8"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "pg": "8.23.0"
  }
}

# Server only. Use separate development and production databases.
DATABASE_URL=
# Optional privileged URL for migrations; never needed by HTTP handlers.
DATABASE_MIGRATION_URL=
# Exact site origin, no trailing slash. Preview may use VERCEL_URL automatically.
APP_ORIGIN=http://127.0.0.1:3000
# Generate with Node crypto.randomBytes(32).toString("hex").
AUTH_SECRET=
